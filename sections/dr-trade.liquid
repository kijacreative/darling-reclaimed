{%- style -%}
  #shopify-section-{{ section.id }} .dr-trade {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .dr-trade {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      --dr-trade-columns: {{ section.settings.columns_desktop }};
    }
  }
{%- endstyle -%}

<div class="dr-trade color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="dr-trade__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="dr-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="dr-heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape | newline_to_br }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="dr-prose dr-trade__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="dr-actions">
          <a
            {% if section.settings.button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.button_link }}"
            {% endif %}
            class="button button--primary"
          >
            {{- section.settings.button_label | escape -}}
          </a>
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="dr-trade__list" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <li class="dr-trade__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a class="dr-trade__link" href="{{ block.settings.link }}">
                  {{- block.settings.text | escape -}}
                </a>
              {%- else -%}
                {{- block.settings.text | escape -}}
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .dr-trade__intro {
    margin-bottom: 4.8rem;
  }

  .dr-trade__text {
    max-width: 52ch;
  }

  .dr-trade__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--dr-trade-columns, 1), minmax(0, 1fr));
    column-gap: 4rem;
    border-top: 1px solid var(--dr-rule);
  }

  .dr-trade__item {
    padding: 1.8rem 0;
    border-bottom: 1px solid var(--dr-rule);
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .dr-trade__link {
    color: inherit;
    text-decoration: none;
  }

  .dr-trade__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DR — Trade program",
  "tag": "section",
  "class": "section dr-section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Trade program"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Built for designers.\nAnd builders."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h0",
          "label": "Extra large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Specification support, trade pricing and material sourcing for residential and commercial projects.</p>"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Columns on desktop",
      "default": 2
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "Join the trade program"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Trade pricing"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DR — Trade program",
      "blocks": [
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        }
      ]
    }
  ]
}
{% endschema %}
