{%- liquid
  assign product = section.settings.product
  assign heading = section.settings.heading
  if heading == blank and product != blank
    assign heading = product.title
  endif

  assign body = section.settings.text
  if body == blank and product != blank
    assign body = product.description
  endif

  assign image = section.settings.image
  if image == blank and product != blank
    assign image = product.featured_image
  endif

  assign shop_url = section.settings.button_link
  if shop_url == blank and product != blank
    assign shop_url = product.url
  endif

  assign sample = section.settings.sample_product
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .dr-finish {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .dr-finish {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="dr-finish color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="dr-finish__grid dr-finish__grid--{{ section.settings.layout }}">
      {%- if image != blank -%}
        <div class="dr-finish__media">
          <div class="dr-finish__media-frame media" style="--dr-ratio: {{ section.settings.image_ratio | divided_by: 100.0 }};">
            {{
              image
              | image_url: width: 2400
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 990px) 1400px, 100vw',
                widths: '550, 750, 1100, 1500, 2000, 2400',
                class: 'dr-finish__image'
            }}
          </div>

          {%- if section.settings.badge != blank -%}
            <span class="dr-finish__badge">{{ section.settings.badge | escape }}</span>
          {%- elsif product != blank and product.available == false -%}
            <span class="dr-finish__badge">{{ 'products.product.sold_out' | t }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="dr-finish__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="dr-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if heading != blank -%}
          <h2 class="dr-heading {{ section.settings.heading_size }}">{{ heading }}</h2>
        {%- endif -%}

        {%- if body != blank -%}
          <div class="dr-prose dr-finish__text">{{ body }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <dl class="dr-finish__specs">
            {%- for block in section.blocks -%}
              {%- liquid
                assign value = block.settings.value

                # When the row names a variant, show that variant's live price
                # instead of the typed-in value, so pricing tracks Shopify.
                if block.settings.variant_title != blank and product != blank
                  for variant in product.variants
                    if variant.title == block.settings.variant_title
                      assign price = variant.price | money
                      if block.settings.unit_suffix != blank
                        assign value = price | append: ' ' | append: block.settings.unit_suffix
                      else
                        assign value = price
                      endif
                      break
                    endif
                  endfor
                endif
              -%}
              {%- if block.settings.label != blank and value != blank -%}
                <div class="dr-finish__spec" {{ block.shopify_attributes }}>
                  <dt class="dr-finish__spec-label">{{ block.settings.label | escape }}</dt>
                  <dd class="dr-finish__spec-value">{{ value }}</dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        {%- endif -%}

        <div class="dr-actions">
          {%- if section.settings.button_label != blank -%}
            <a
              {% if shop_url == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ shop_url }}"
              {% endif %}
              class="button button--primary"
            >
              {{- section.settings.button_label | escape -}}
            </a>
          {%- endif -%}

          {%- if section.settings.sample_button_label != blank -%}
            <a
              {%- comment -%} An explicit link wins, so CTAs can open the calculator. {%- endcomment -%}
              {% if section.settings.sample_button_link != blank %}
                href="{{ section.settings.sample_button_link }}"
              {% elsif sample != blank %}
                href="{{ sample.url }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="button button--secondary"
            >
              {{- section.settings.sample_button_label | escape -}}
              {%- if sample != blank %} — {{ sample.price | money }}{% endif -%}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .dr-finish__grid {
    display: grid;
    gap: 4rem;
  }

  .dr-finish__media {
    position: relative;
  }

  .dr-finish__media-frame {
    position: relative;
    overflow: hidden;
    padding-bottom: calc(100% / var(--dr-ratio, 1.6));
    background-color: rgb(var(--dr-greige));
  }

  .dr-finish__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dr-finish__badge {
    position: absolute;
    top: 1.6rem;
    left: 1.6rem;
    background-color: rgb(var(--dr-offwhite));
    color: rgb(var(--dr-body-ink));
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.7rem 1.2rem;
  }

  .dr-finish__text {
    max-width: 54ch;
  }

  /* Spec table */
  .dr-finish__specs {
    margin: 3.2rem 0 0;
    max-width: 46rem;
  }

  .dr-finish__spec {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.3rem 0;
    border-bottom: 1px solid var(--dr-rule);
  }

  .dr-finish__spec:first-child {
    border-top: 1px solid var(--dr-rule);
  }

  .dr-finish__spec-label {
    margin: 0;
    color: rgba(var(--color-foreground), 0.62);
    font-size: 1.5rem;
  }

  .dr-finish__spec-value {
    margin: 0;
    font-weight: 600;
    font-size: 1.5rem;
    text-align: right;
  }

  @media screen and (min-width: 990px) {
    .dr-finish__grid--side-by-side {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 6rem;
    }

    .dr-finish__grid--side-by-side .dr-finish__content {
      padding-block: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DR — Featured finish",
  "tag": "section",
  "class": "section dr-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Supplies the image, title, description, link and live variant pricing when the fields below are left empty."
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "stacked",
          "label": "Image above content"
        },
        {
          "value": "side-by-side",
          "label": "Image beside content"
        }
      ],
      "default": "stacked",
      "label": "Layout"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Defaults to the product's featured image."
    },
    {
      "type": "range",
      "id": "image_ratio",
      "min": 60,
      "max": 240,
      "step": 10,
      "label": "Image width as % of height",
      "default": 160,
      "unit": "%"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Best seller"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Defaults to the product title."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h0",
          "label": "Extra large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "Defaults to the product description."
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "Shop this finish"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link",
      "info": "Defaults to the product page."
    },
    {
      "type": "header",
      "content": "Sample button"
    },
    {
      "type": "text",
      "id": "sample_button_label",
      "label": "Label",
      "default": "Order a sample"
    },
    {
      "type": "product",
      "id": "sample_product",
      "label": "Sample product",
      "info": "When set, its price is appended to the label and the button links to it."
    },
    {
      "type": "url",
      "id": "sample_button_link",
      "label": "Link",
      "info": "Used only when no sample product is chosen."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Coverage per box"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "10 sq. ft."
        },
        {
          "type": "text",
          "id": "variant_title",
          "label": "Variant name",
          "info": "Optional. Must match a variant name on the product exactly — its live price then replaces the value above."
        },
        {
          "type": "text",
          "id": "unit_suffix",
          "label": "Price suffix",
          "info": "Appended after a variant price, e.g. \"/ sq. ft.\""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DR — Featured finish",
      "blocks": [
        {
          "type": "spec"
        },
        {
          "type": "spec"
        },
        {
          "type": "spec"
        },
        {
          "type": "spec"
        }
      ]
    }
  ]
}
{% endschema %}
