{%- liquid
  assign parallax = section.settings.parallax
  if section.settings.image == blank
    assign parallax = false
  endif

  assign range = 0
  if parallax
    assign range = section.settings.parallax_intensity
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .dr-hero {
    --dr-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --dr-hero-gradient: {{ section.settings.overlay_gradient | divided_by: 100.0 }};
    --dr-hero-parallax: {{ range }};
    --dr-hero-footnote-gap: {{ section.settings.footnote_spacing }}px;
    --dr-hero-min-height: {{ section.settings.height_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .dr-hero {
      --dr-hero-min-height: {{ section.settings.height_desktop }}px;
    }
  }
{%- endstyle -%}

<div
  class="dr-hero color-{{ section.settings.color_scheme }}"
  {% if parallax %}
    data-parallax="true"
    data-parallax-range="{{ section.settings.parallax_intensity }}"
  {% endif %}
>
  {%- if section.settings.image != blank -%}
    <div class="dr-hero__media">
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '750, 1100, 1500, 1780, 2000, 2500, 3000, 3840',
          class: 'dr-hero__image'
      }}
    </div>
  {%- endif -%}

  <div class="dr-hero__scrim" aria-hidden="true"></div>

  <div class="page-width dr-hero__inner dr-hero__inner--{{ section.settings.content_position }}">
    <div class="dr-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="dr-eyebrow dr-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="dr-heading dr-hero__heading {{ section.settings.heading_size }}">
          {{- section.settings.heading | escape | newline_to_br -}}
        </h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="dr-prose dr-hero__subheading dr-measure">{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
        <div class="dr-actions">
          {%- if section.settings.button_label != blank -%}
            <a
              {% if section.settings.button_link == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.button_link }}"
              {% endif %}
              class="button button--primary"
            >
              {{- section.settings.button_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a
              {% if section.settings.button_link_2 == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.button_link_2 }}"
              {% endif %}
              class="button button--secondary dr-hero__button-outline"
            >
              {{- section.settings.button_label_2 | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.footnote != blank -%}
        <p class="dr-eyebrow dr-hero__footnote">{{ section.settings.footnote | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .dr-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--dr-hero-min-height, 720px);
    overflow: hidden;
    background-color: rgb(var(--dr-ink));
  }

  /*
    The media is grown by the parallax range at top and bottom so the drift
    never exposes an edge. With parallax off the range is 0 and it sits flush.
  */
  .dr-hero__media {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(-1% * var(--dr-hero-parallax, 0));
    bottom: calc(-1% * var(--dr-hero-parallax, 0));
  }

  .dr-hero[data-parallax='true'] .dr-hero__media {
    will-change: transform;
  }

  .dr-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /*
    Two independent layers so the control means what it says:
    a flat wash at exactly `overlay_opacity`, plus an optional directional
    boost on the content side. Both reach zero, so 0% is genuinely no overlay.
  */
  .dr-hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        100deg,
        rgba(var(--dr-ink), var(--dr-hero-gradient, 0)) 0%,
        rgba(var(--dr-ink), 0) 68%
      ),
      linear-gradient(
        rgba(var(--dr-ink), var(--dr-hero-overlay, 0)),
        rgba(var(--dr-ink), var(--dr-hero-overlay, 0))
      );
  }

  .dr-hero__inner {
    position: relative;
    width: 100%;
    display: flex;
    padding-top: 8rem;
    padding-bottom: 8rem;
  }

  .dr-hero__inner--left { justify-content: flex-start; }
  .dr-hero__inner--center { justify-content: center; }
  .dr-hero__inner--right { justify-content: flex-end; }

  .dr-hero__content {
    max-width: 62rem;
  }

  .dr-hero__inner--center .dr-hero__content {
    text-align: center;
  }

  .dr-hero__inner--center .dr-hero__subheading {
    margin-inline: auto;
  }

  .dr-hero__inner--center .dr-actions {
    justify-content: center;
  }

  /* Hero always sits on imagery, so copy is locked to the light end of the palette */
  .dr-hero__heading,
  .dr-hero__subheading {
    color: rgb(var(--dr-bone));
  }

  .dr-hero__eyebrow,
  .dr-hero__footnote {
    color: rgba(var(--dr-bone), 0.82);
  }

  .dr-hero__footnote {
    margin: var(--dr-hero-footnote-gap, 24px) 0 0;
  }

  /* Outline CTA reads on imagery rather than on a scheme background */
  .dr-hero .dr-hero__button-outline {
    --color-secondary-button-text: var(--dr-bone);
    background-color: transparent;
    box-shadow: inset 0 0 0 var(--buttons-border-width) rgb(var(--dr-bone));
    color: rgb(var(--dr-bone));
  }

  @media (prefers-reduced-motion: reduce) {
    .dr-hero__media {
      transform: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .dr-hero__inner {
      padding-top: 6rem;
      padding-bottom: 6rem;
    }

    .dr-hero__content {
      max-width: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /*
    Hero parallax. Drifts the media against the page as the hero crosses the
    viewport. Reads the scroll position in a rAF frame and only writes a
    transform, so it stays off the layout path.
  */
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var heroes = [];
    var ticking = false;

    function collect() {
      heroes = Array.prototype.slice.call(
        document.querySelectorAll('.dr-hero[data-parallax="true"]')
      );
    }

    function clear() {
      heroes.forEach(function (hero) {
        var media = hero.querySelector('.dr-hero__media');
        if (media) media.style.transform = '';
      });
    }

    function update() {
      ticking = false;
      if (reduce.matches) return;

      var vh = window.innerHeight;

      heroes.forEach(function (hero) {
        var media = hero.querySelector('.dr-hero__media');
        if (!media) return;

        var rect = hero.getBoundingClientRect();
        if (rect.bottom < 0 || rect.top > vh) return;

        var range = parseFloat(hero.getAttribute('data-parallax-range')) || 0;
        if (!range) return;

        /* 0 as the hero enters from below, 1 as it leaves past the top */
        var progress = (vh - rect.top) / (vh + rect.height);
        var shift = (progress - 0.5) * range;

        media.style.transform = 'translate3d(0, ' + shift.toFixed(3) + '%, 0)';
      });
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    function init() {
      collect();
      if (!heroes.length) return;
      update();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    /* Theme editor re-renders the section on every setting change */
    document.addEventListener('shopify:section:load', init);
    document.addEventListener('shopify:section:unload', init);

    if (reduce.addEventListener) {
      reduce.addEventListener('change', function () {
        if (reduce.matches) clear();
        else update();
      });
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "DR — Hero",
  "tag": "section",
  "class": "section dr-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay strength",
      "default": 30,
      "info": "An even wash across the whole image. 0% removes it completely."
    },
    {
      "type": "range",
      "id": "overlay_gradient",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Extra shading behind text",
      "default": 25,
      "info": "Added on the content side only, fading out toward the far edge."
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "parallax",
      "label": "Parallax background",
      "default": true
    },
    {
      "type": "range",
      "id": "parallax_intensity",
      "min": 2,
      "max": 30,
      "step": 2,
      "unit": "%",
      "label": "Parallax depth",
      "default": 12,
      "info": "Ignored when a visitor has reduced motion turned on."
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "label": "Desktop height",
      "default": 760
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Mobile height",
      "default": 560
    },
    {
      "type": "select",
      "id": "content_position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Content position"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Reclaimed wood wall paneling"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Wood with a past.",
      "info": "Press return for a line break."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" },
        { "value": "hxl", "label": "Huge" }
      ],
      "default": "h0",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Authentic reclaimed wood, transformed into premium wall paneling for spaces with a little more soul.</p>"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "Real reclaimed wood. Made in Texas."
    },
    {
      "type": "range",
      "id": "footnote_spacing",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Space above footnote",
      "default": 24
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "Shop wall paneling"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Label",
      "default": "Order samples"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    }
  ],
  "presets": [
    {
      "name": "DR — Hero"
    }
  ]
}
{% endschema %}
