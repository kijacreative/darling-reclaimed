    "process": {
      "type": "dr-process",
      "blocks": {
        "reclaim": {
          "type": "step",
          "settings": {
            "icon": "fence",
            "heading": "Reclaim",
            "text": "<p>We take fence lines down board by board, by hand. Anything cracked, rotten or too far gone stays on the trailer.</p>"
          }
        },
        "prepare": {
          "type": "step",
          "settings": {
            "icon": "plank",
            "heading": "Prepare",
            "text": "<p>Cleaned, treated and kiln dried, then cut to a consistent thickness so the rows sit tight and the wall hangs flat.</p>"
          }
        },
        "peel": {
          "type": "step",
          "settings": {
            "icon": "peel",
            "heading": "Peel",
            "text": "<p>Choose Peel &amp; Stick and the adhesive backing goes on in our shop. Pull the liner when you are ready.</p>"
          }
        },
        "stick": {
          "type": "step",
          "settings": {
            "icon": "grid",
            "heading": "Stick",
            "text": "<p>Measure, cut where you need to, press. Your wall just got considerably more interesting.</p>"
          }
        }
      },
      "block_order": [
        "reclaim",
        "prepare",
        "peel",
        "stick"
