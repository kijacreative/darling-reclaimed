{%- comment -%}
  Global ordering calculator, rendered once per page in theme.liquid.
  Any link to #calculator, or any element with [data-dr-calc-open], opens it.
  Configured from Theme settings → Ordering calculator.

  Each installation option may name its own product, so a specialty cut sold
  as a separate product can sit alongside the standard finishes.
{%- endcomment -%}

{%- capture options_json -%}
[
  {%- assign wrote = false -%}
  {%- for n in (1..3) -%}
    {%- liquid
      case n
        when 1
          assign label = settings.calc_option_1_label
          assign vtitle = settings.calc_option_1_variant
          assign source = settings.calc_option_1_product
          assign cov = settings.calc_option_1_coverage
          assign note = settings.calc_option_1_note
        when 2
          assign label = settings.calc_option_2_label
          assign vtitle = settings.calc_option_2_variant
          assign source = settings.calc_option_2_product
          assign cov = settings.calc_option_2_coverage
          assign note = settings.calc_option_2_note
        when 3
          assign label = settings.calc_option_3_label
          assign vtitle = settings.calc_option_3_variant
          assign source = settings.calc_option_3_product
          assign cov = settings.calc_option_3_coverage
          assign note = settings.calc_option_3_note
      endcase

      if source == blank
        assign source = settings.calc_product
      endif

      if cov == 0
        assign cov = settings.calc_coverage_per_box
      endif

      assign vid = ''
      assign vprice = 0
      assign vavail = false
      if source != blank and vtitle != blank
        for variant in source.variants
          if variant.title == vtitle
            assign vid = variant.id
            assign vprice = variant.price
            assign vavail = variant.available
            break
          endif
        endfor
      endif
    -%}
    {%- if label != blank -%}
      {%- if wrote -%},{%- endif -%}
      {
        "id": "opt{{ n }}",
        "label": {{ label | json }},
        "variantId": {{ vid | json }},
        "price": {{ vprice | json }},
        "coverage": {{ cov | json }},
        "note": {{ note | json }},
        "available": {{ vavail | json }}
      }
      {%- assign wrote = true -%}
    {%- endif -%}
  {%- endfor -%}
]
{%- endcapture -%}

<dialog class="dr-modal" id="dr-calculator-modal" aria-labelledby="dr-modal-title">
  <div class="dr-modal__inner color-scheme-1">
    <button class="dr-modal__close" type="button" data-dr-calc-close>
      <span class="visually-hidden">Close</span>
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M4 4l12 12M16 4L4 16" stroke-linecap="round" />
      </svg>
    </button>

    <div class="dr-modal__head">
      {%- if settings.calc_eyebrow != blank -%}
        <p class="dr-eyebrow">{{ settings.calc_eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="dr-heading h2" id="dr-modal-title">
        {{- settings.calc_heading | default: 'How much wood do you need?' -}}
      </h2>
      {%- if settings.calc_text != blank -%}
        <div class="dr-prose dr-calc__text">{{ settings.calc_text }}</div>
      {%- endif -%}
    </div>

    {% render 'dr-calculator-form',
      uid: 'modal',
      coverage: settings.calc_coverage_per_box,
      unit: settings.calc_pricing_unit,
      options_json: options_json,
      submit_label: settings.calc_submit_label,
      footnote: settings.calc_footnote
    %}
  </div>
</dialog>
